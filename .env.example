# Kopieer dit bestand naar .env.local en vul de waarden in.
# .env.local staat in .gitignore en gaat nooit mee naar GitHub.
# Zonder deze waarden draait de site ook: dan gebruikt hij de standaardteksten uit de code.

# Supabase: de teksten van / en /over komen uit het portaal (zie content-manifest.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
TENANT_ID=

# Portaal: voorbeeldweergave en direct bijwerken na een tekstwijziging
PORTAAL_BFF_URL=
PORTAAL_PREVIEW_SECRET=
PORTAAL_REVALIDATE_SECRET=

# Configurator (/configurator): waar de ingevulde aanvraag naartoe gaat
CONFIGURATOR_WEBHOOK_URL=

# Gespreksformulier (/gesprek): het geheim waarmee de code in de maillink is ondertekend,
# en het adres en het gedeelde geheim van de ontvanger in de loopless-outreach-app
# (api/gesprek.js daar). Alleen server-side. Bewust géén databasesleutel van
# loopless-outreach in dit project: zie de kop van src/app/api/gesprek/route.ts.
GESPREK_SECRET=
GESPREK_DOORSTUUR_URL=
GESPREK_DOORSTUUR_SECRET=
